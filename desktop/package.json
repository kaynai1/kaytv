{
  "name": "kaytv-desktop",
  "version": "0.3.2",
  "private": true,
  "description": "KayTV Windows desktop shell",
  "main": "main.cjs",
  "scripts": {
    "prepare:web": "node prepare-web.mjs",
    "start": "npm run prepare:web && electron .",
    "dist": "npm run prepare:web && electron-builder --win --x64 --publish never --config.electronDist=node_modules/electron/dist"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.kaynai.kaytv",
    "productName": "KayTV",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "web/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "KayTV-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "KayTV-${version}-portable.${ext}"
    }
  }
}
